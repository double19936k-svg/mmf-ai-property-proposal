      "model": "grok-imagine-image-2.0",
      "timeout": 120,
      "health_timeout": 20,
      "extra_options": {
        "backend": "xai_imagine"
      },
      "billing_note": "使用 xAI Imagine API 生成图片，需要单独的 XAI_API_KEY。",
      "qualification_status": "image_service",
      "test_mode": false
    },
    {
      "provider_name": "mock",
      "display_name": "Mock Provider（测试模式）",
      "provider_type": "mock",
      "enabled": true,
      "model": "deterministic-mock-v0.1",
      "reasoning_mode": "none",
      "endpoint_alias": "in_process_test_only",
      "qualification_status": "test_only",
      "test_mode": true
    }
