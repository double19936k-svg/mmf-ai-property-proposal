  "matcher_discipline": {
    "mechanical_scan": [
      "unit-bearing numbers (extend CG-001 beyond historic KU numerals to any unconfirmed C1)",
      "lexicon hits for C2–C10 and semantic equivalents",
      "banned meta phrases for Gate 4",
      "KUC.forbidden_escalations substring/equivalent match"
    ],
    "light_semantic": [
      "classify sentence language_level",
      "map claim_type C1–C10",
      "detect condition dropped (must_conditionalize true but sentence is FACT/COMMITMENT)",
      "detect plausible-default upgrade"
    ],
    "provider_self_check": [
      "only residual ambiguous sentences after local gates",
      "never a second-provider audit",
      "never authority over local BLOCK"
    ],
    "not_allowed": [
      "Qwen generate → Grok review",
      "Grok generate → Qwen review"
    ]
  },
  "repair_playbook": [
    {
      "id": "RP-CONDITIONALIZE",
      "use_when": "CONDITIONAL_KU or unknown Brief field",
      "action": "rewrite with frontend_conditional_phrasing; move uncertainty to clarification_list not body banners"
    },
    {
      "id": "RP-DOWNGRADE-RECOMMENDATION",
      "use_when": "PROVIDER_INFERENCE non-core",
      "action": "建议 + 结合现场条件, no 必须/实行"
    },
    {
      "id": "RP-METHOD-ONLY",
      "use_when": "UNCONDITIONAL_KU_METHOD nouns look like posts (固定岗)",
      "action": "按区域明确值守与巡逻责任, do not assert established posts or headcount"
    },
    {
      "id": "RP-DELETE-COMMITMENT",
      "use_when": "UNSUPPORTED C1–C10",
      "action": "delete number/post/model/policy; keep surrounding in-scope method"
    },
    {
      "id": "RP-CLARIFY-OFFBODY",
      "use_when": "high-impact unknown",
      "action": "human_confirmation_question; do not print 待确认 in every section (style M-009)"
    }
  ],
  "red_team_challenges": [
    {
      "bypass": "avoid 24小时 write 全天候监控覆盖",
      "must_catch": true,
      "rule": "semantic_equivalents C9"
