  "decision_matrix": [
    {
      "provenance_type": "PROJECT_FACT",
      "decision": "PASS",
      "conditionalization_rule": null,
      "block_rule": null,
      "repair_strategy": "keep"
    },
    {
      "provenance_type": "CLIENT_CONFIRMED",
      "decision": "PASS",
      "conditionalization_rule": null,
      "block_rule": null,
      "repair_strategy": "keep"
    },
    {
      "provenance_type": "CURRENT_CONTRACT",
      "decision": "PASS",
      "conditionalization_rule": null,
      "block_rule": "if quote exceeds provided contract excerpt → BLOCK",
      "repair_strategy": "cite contract or demote"
    },
    {
      "provenance_type": "CURRENT_POLICY",
      "decision": "PASS",
      "conditionalization_rule": null,
      "block_rule": "company L0 policy original names/dates → BLOCK (existing guardrail)",
      "repair_strategy": "method-only rewrite"
    },
    {
      "provenance_type": "UNCONDITIONAL_KU_METHOD",
      "decision": "PASS_IF_METHOD_ONLY",
      "conditionalization_rule": "keep as method/RACI skeleton, not as installed posts, frequencies, or commercial terms",
      "block_rule": "if escalated to C1–C10 project commitment → BLOCK",
      "repair_strategy": "downgrade_to_method_or_recommendation"
    },
    {
      "provenance_type": "CONDITIONAL_KU",
      "decision": "PASS_IF_CONDITION_SATISFIED_ELSE_CONDITIONALIZE_OR_BLOCK",
      "conditionalization_rule": "condition unknown → CONDITIONALIZE with frontend phrasing; do not announce the condition is missing",
      "block_rule": "condition false → BLOCK; condition unknown but written as fact → BLOCK",
      "repair_strategy": "apply frontend_conditional_phrasing from KUC"
    },
    {
      "provenance_type": "PROVIDER_INFERENCE",
      "decision": "KEEP_IF_NON_COMMITMENT_ELSE_BLOCK_OR_CLARIFY",
      "conditionalization_rule": "non-commitment scene-setting may become RECOMMENDATION/OPTION",
      "block_rule": "if claim_type C1–C10 → BLOCK or CLARIFY off-body",
      "repair_strategy": "delete inferred fact; optional human_confirmation_question"
    },
    {
      "provenance_type": "UNSUPPORTED",
      "decision": "BLOCK",
      "conditionalization_rule": null,
      "block_rule": "always",
      "repair_strategy": "delete or replace with in-scope method"
    }
  ],
  "plausible_but_unconfirmed": {
    "principle": "Plausibility is not evidence. Industry default may seed RECOMMENDATION or CONDITIONAL_METHOD only.",
    "examples": [
      {
        "industry_default": "产业园通常24小时监控",
        "not_equal_to": "本项目已确认24小时监控值守",
        "claim_types": [
          "C9",
          "C2"
        ]
      },
      {
        "industry_default": "宿舍通常有门禁卡",
        "not_equal_to": "本项目发放门禁卡并签住宿协议",
        "claim_types": [
          "C4",
          "C6"
        ]
      },
      {
        "industry_default": "保洁通常每日",
        "not_equal_to": "本项目每日清洁且考核挂钩结算",
        "claim_types": [
