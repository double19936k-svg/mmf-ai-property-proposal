    {
      "claim_type": "C9",
      "name": "TechnologyCommitment",
      "covers": [
        "已部署某系统",
        "24小时监控",
        "平台能力",
        "设备配置"
      ]
    },
    {
      "claim_type": "C10",
      "name": "PolicyCommitment",
      "covers": [
