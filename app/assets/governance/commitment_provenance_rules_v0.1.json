{
  "schema_version": "commitment-provenance-rules-v0.1",
  "gate_id": "GATE-3",
  "definition": "A Commitment Claim is any wording a lay reader would take as ‘this project will execute this way’.",
  "language_levels": [
    {
      "level": "FACT",
      "reader_effect": "already true here",
      "allowed_when": [
        "PROJECT_FACT",
        "CLIENT_CONFIRMED",
        "CURRENT_CONTRACT",
        "CURRENT_POLICY"
      ]
    },
    {
      "level": "COMMITMENT",
      "reader_effect": "will be done on this project",
      "allowed_when": [
        "PROJECT_FACT",
        "CLIENT_CONFIRMED",
        "CURRENT_CONTRACT",
        "satisfied CONDITIONAL_KU"
      ]
    },
    {
      "level": "RECOMMENDATION",
      "reader_effect": "advised, not decided",
      "allowed_when": [
        "UNCONDITIONAL_KU_METHOD",
        "PROVIDER_INFERENCE if non-commitment"
      ]
    },
    {
      "level": "OPTION",
      "reader_effect": "one possible path",
      "allowed_when": [
        "unknown operating model / access / staffing"
      ]
    },
    {
      "level": "CONDITIONAL_METHOD",
      "reader_effect": "method applies when a condition holds",
      "allowed_when": [
        "CONDITIONAL_KU with unknown or pending condition"
      ]
    }
  ],
  "provenance_types": [
    "PROJECT_FACT",
    "CLIENT_CONFIRMED",
    "CURRENT_CONTRACT",
    "CURRENT_POLICY",
    "UNCONDITIONAL_KU_METHOD",
    "CONDITIONAL_KU",
    "PROVIDER_INFERENCE",
    "UNSUPPORTED"
  ],
  "claim_types": [
    {
      "claim_type": "C1",
      "name": "NumericCommitment",
      "covers": [
        "人数",
        "时间",
        "频次",
