        ]
      },
      {
        "industry_default": "厂房通常封闭",
        "not_equal_to": "本项目实行封闭管理",
        "claim_types": [
          "C4",
          "C10"
        ]
      }
    ],
    "allowed_suggestion_example": "建议结合园区封闭条件设置重点值守区域。",
    "forbidden_upgrade_example": "厂房区域实行封闭管理，出入口设置固定岗，监控中心24小时值守。"
  },
