# Copy this file to .env for local use.
# Fill in YOUR own keys. Never commit real values.

DASHSCOPE_API_KEY=YOUR_QWEN_API_KEY
MOONSHOT_API_KEY=YOUR_KIMI_API_KEY
XAI_API_KEY=YOUR_XAI_API_KEY

# Optional. Most users do not need this.
# OPENAI_API_KEY=YOUR_API_KEY_HERE

# The desktop UI can also save keys into Windows Credential Manager.
# Do not put real keys in config/providers.local.json or in Git.
